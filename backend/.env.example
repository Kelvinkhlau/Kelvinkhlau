# Copy this file to .env and fill in your values.
# The backend loads it automatically via python-dotenv.

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Database ---
# Defaults to sqlite://./life_manager.db if unset.
# DATABASE_URL=sqlite:///./life_manager.db

# --- OpenAI (Phase 5) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google / Gmail / Calendar (Phase 2, 6) ---
GMAIL_CREDENTIALS_PATH=
GOOGLE_CALENDAR_CREDENTIALS_PATH=

# --- iCloud (Phase 2) ---
ICLOUD_CREDENTIALS_PATH=

# --- Cost control ---
MONTHLY_API_BUDGET=15.0

# --- Email sync ---
SYNC_INTERVAL_SECONDS=300
EMAIL_BATCH_SIZE=20

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
