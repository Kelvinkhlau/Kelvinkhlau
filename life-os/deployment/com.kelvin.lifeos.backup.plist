<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job — 每個星期日 04:00 做完整系統備份（SQLite DB + vault 所有檔案）。

  安裝：
    cp deployment/com.kelvin.lifeos.backup.plist ~/Library/LaunchAgents/
    # 編輯 __PROJECT_ROOT__ 同 __USER_HOME__ 變 absolute path
    launchctl load ~/Library/LaunchAgents/com.kelvin.lifeos.backup.plist

  手動觸發：
    launchctl start com.kelvin.lifeos.backup

  注意：後端 APScheduler 都會每星期日 04:00 做同樣嘅備份（雙保險）。
  如果你已經裝咗呢個 plist，可以揀一個用 — 兩個都裝無害，tarball 命名包 timestamp。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kelvin.lifeos.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/backup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- 每個星期日 04:00 跑一次 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Mac 睡咗 / 當時關機，下次 wake 補跑 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__USER_HOME__/Library/Logs/lifeos-backup.out.log</string>

    <key>StandardErrorPath</key>
    <string>__USER_HOME__/Library/Logs/lifeos-backup.err.log</string>
</dict>
</plist>
