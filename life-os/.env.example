# life-os 環境變數範例
# Copy 呢個檔做 .env 然後填返自己嘅值
# .env 唔會 push 上 git

# === 基本 ===
APP_ENV=development              # development | production
APP_HOST=127.0.0.1
APP_PORT=4100
APP_SECRET_KEY=請用_openssl_rand_-hex_32_生成

# === Database ===
DATABASE_URL=sqlite:///./data/lifeos.db
# 用 SQLCipher 加密時：
# DATABASE_URL=sqlite+pysqlcipher://:your_db_password@/./data/lifeos.db
DATABASE_ENCRYPTION_KEY=請填_database_加密_key

# === AI provider ===
# "auto"（預設）= Anthropic 行先，失敗 fallback OpenAI
# 或者寫死 "anthropic" / "openai" 只用一個
AI_PROVIDER=auto

# === OpenAI ===
# 分類 email 用 gpt-4o-mini（平、快、夠用）
# 將來語音轉錄亦都用呢個 key
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# === Anthropic Claude API（備用） ===
# 如果想用 Claude 做分類，set AI_PROVIDER=anthropic 同填返個 key
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# === Gmail OAuth2 ===
# 喺 https://console.cloud.google.com 開個 project
# 開啟 Gmail API、建立 OAuth2 client (Desktop application)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/gmail/callback

# === 用戶（單用戶系統） ===
OWNER_EMAIL=you@example.com
OWNER_NAME=Kelvin

# === Frontend URL ===
# 開發時：http://localhost:3000（Next.js dev server）
# 部署時：同 PUBLIC_BASE_URL 一樣
FRONTEND_URL=http://localhost:3000

# === 部署 ===
# PUBLIC_BASE_URL=https://lifeos.tail-xxxx.ts.net
# FRONTEND_URL=https://lifeos.tail-xxxx.ts.net
